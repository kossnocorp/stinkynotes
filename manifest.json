{
  "name": "Stinky Notes",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "Sticky notes on any webpage",
  "permissions": ["storage", "activeTab", "scripting"],
  "icons": {
    "16": "icons/extension-16.png",
    "48": "icons/extension-48.png",
    "128": "icons/extension-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/gray-16.png",
      "32": "icons/gray-32.png",
      "48": "icons/gray-48.png",
      "128": "icons/gray-128.png"
    },
    "default_title": "Sticky Note"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "css": ["styles.css"]
    }
  ]
}
